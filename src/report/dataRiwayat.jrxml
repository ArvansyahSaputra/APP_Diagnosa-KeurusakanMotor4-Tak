     riwayat_diagnosa.`tanggal` AS riwayat_diagnosa_tanggal,
     riwayat_diagnosa.`id_akun` AS riwayat_diagnosa_id_akun,
     riwayat_diagnosa.`jenis_kendaraan` AS riwayat_diagnosa_jenis_kendaraan,
     riwayat_diagnosa.`gejala_dipilih` AS riwayat_diagnosa_gejala_dipilih,
     riwayat_diagnosa.`kode_kerusakan_hasil` AS riwayat_diagnosa_kode_kerusakan_hasil,
     riwayat_diagnosa.`nama_kerusakan_hasil` AS riwayat_diagnosa_nama_kerusakan_hasil,
     riwayat_diagnosa.`cf_akhir` AS riwayat_diagnosa_cf_akhir
FROM
     `riwayat_diagnosa` riwayat_diagnosa]]>
	</queryString>
